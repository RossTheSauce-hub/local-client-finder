# Google Places API (New) — enable "Places API (New)" in Google Cloud Console
GOOGLE_PLACES_API_KEY=

# GoHighLevel Private Integration token (Settings → Private Integrations)
# Needs the contacts.write / contacts.readonly scopes
GHL_PRIVATE_TOKEN=

# GoHighLevel sub-account (location) ID
GHL_LOCATION_ID=

# Tag applied to captured contacts — a GHL workflow can trigger off this
GHL_TAG=lead-magnet-client-finder

# Sales page for The 30-Day First Client System
COURSE_URL=https://example.com/course

# Optional: fresh searches allowed per IP per day (default 3)
# RATE_LIMIT_PER_DAY=3

# Dev only: use fake business data instead of the Places API (ignored in production)
# MOCK_PLACES=1
